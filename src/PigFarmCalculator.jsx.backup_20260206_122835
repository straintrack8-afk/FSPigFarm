// HELPER: Calculate Gilt Replacements (Progressive)
// NOW SUPPORTS: Manual Cohort Specific Replacements via `manualCohorts` param.
const calculateGiltReplacements = (inputs, projectDuration, manualCohorts = []) => {
    const replacements = [];

    // Ensure inputs have defaults
    // Use inputs.breedingSowCapacity if valid > 0, else 100. (User might want 0? Unlikely for calculation mode)
    // If it's literally 0, we accept it, but if it's undefined/NaN, use 100.
    const rawCap = parseFloat(inputs.breedingSowCapacity);
    const breedingSowCapacity = (!isNaN(rawCap)) ? rawCap : 0;

    const cullingRateY1 = inputs.cullingRateY1 || 0;
    const cullingRateY2 = inputs.cullingRateY2 || 0.30;
    const cullingRateY3Plus = inputs.cullingRateY3Plus || 0.40;

    // Debug: Log all culling rates at start of calculation
    console.log(`🔍 SETUP VALUES RECEIVED: Y1=${(cullingRateY1 * 100).toFixed(0)}%, Y2=${(cullingRateY2 * 100).toFixed(0)}%, Y3+=${(cullingRateY3Plus * 100).toFixed(0)}%`);
    console.log(`🔍 RAW INPUTS: cullingRateY1=${inputs.cullingRateY1}, cullingRateY2=${inputs.cullingRateY2}, cullingRateY3Plus=${inputs.cullingRateY3Plus}`);

    // Use defined lead time or default to 7
    const giltLeadTime = inputs.giltLeadTime !== undefined ? inputs.giltLeadTime : 7;

    // Ensure projectDuration is valid
    const duration = (projectDuration && projectDuration > 0) ? projectDuration : 5;

    // console.log("DEBUG: Gilt Calc Inputs:", { breedingSowCapacity, cullingRateY1, cullingRateY2, duration });

    // STABLE HERD STRATEGY (If Capacity Set)
    if (inputs.rawBreedingSowCapacity > 0) {
        // Uniform replacement rate for established herd
        const replacementRate = (inputs.cohort0ReplacementRate !== undefined ? inputs.cohort0ReplacementRate : 40) / 100;
        const annualReplacements = breedingSowCapacity * replacementRate;
        const monthlyReplacementFloat = annualReplacements / 12;
        let replacementAccumulator = 0;

        // Start from Year 1, but add late Year 0 for transition
        // ONLY if we have an explicit User Capacity (Stable Start).
        // If Capacity is 0 (Manual Mode), we do NOT generate Year 0 replacements (no ghost sows).
        const startYear = (inputs.rawBreedingSowCapacity && inputs.rawBreedingSowCapacity > 0) ? 0 : 1;

        for (let year = startYear; year <= duration; year++) {
            // For Year 0, only generate replacements for the last X months (transition period = lead time)
            // This ensures meaningful "Sow Prod" in Month 1 without overshoot.
            const transitionMonths = giltLeadTime;
            const startMonth = year === 0 ? (12 - transitionMonths + 1) : 1;
            for (let month = startMonth; month <= 12; month++) {
                const monthIndex = (year - 1) * 12 + month - 1;
                const productiveMonthIndex = monthIndex + giltLeadTime;

                // ACCUMULATOR LOGIC: Add float entitlement, take integer floor
                replacementAccumulator += monthlyReplacementFloat;
                const replaceCount = Math.floor(replacementAccumulator);

                if (replaceCount > 0) {
                    replacementAccumulator -= replaceCount;

                    replacements.push({
                        monthIndex,
                        productiveMonthIndex,
                        giltsAdded: replaceCount,
                        year,
                        quarter: Math.ceil(month / 3),
                        monthYear: getMonthYear(monthIndex, inputs.projectStartDate),
                        productiveMonthYear: getMonthYear(productiveMonthIndex, inputs.projectStartDate),
                        cullingRate: replacementRate,
                        dayNumber: monthIndex * 30,
                        cohortId: `GILT-Y${year}-M${month}-Stable`
                    });
                }
            }
        }
    }
    // GROWTH STRATEGY (Manual Cohorts Ramp-up)
    else {
        // Manual Cohorts: Progressive Culling starting strictly 1 year after entry.
        // Logic: 
        // Months 0-12 (Year 1): No culling/replacements.
        // Months 13-24 (Year 2): cullingRateY2.
        // Months 25+ (Year 3+): cohort0ReplacementRate.

        const replacementRateStable = (inputs.cohort0ReplacementRate !== undefined ? inputs.cohort0ReplacementRate : 40) / 100;
        const cullingRateY2 = inputs.cullingRateY2 || 0.30;

        if (manualCohorts && manualCohorts.length > 0) {
            manualCohorts.forEach(cohort => {
                const entryCount = parseFloat(cohort.numberOfGilts) || 0;

                // Calculate Entry Month Index relative to Project Start
                let entryMonthIndex = 0;
                if (cohort.entryDate && inputs.projectStartDate) {
                    const start = new Date(inputs.projectStartDate);
                    const entry = new Date(cohort.entryDate);
                    // Standardize to start of month to avoid off-by-one errors
                    start.setDate(1); entry.setDate(1);
                    entryMonthIndex = (entry.getFullYear() - start.getFullYear()) * 12 + (entry.getMonth() - start.getMonth());
                }

                // We assume entryMonthIndex is valid (can be negative if started before project, but usually >= 0)
                // Iterate through the Project timeline (Month 0 to duration*12)

                let cohortReplacementAccumulator = 0;

                for (let m = 0; m <= duration * 12; m++) {
                    const monthsSinceEntry = m - entryMonthIndex;

                    // STRICT RULE: Replacements only start after Year 1 (Month 12 of Cohort Life)
                    // If monthsSinceEntry <= 12, we are in the initial productive phase.
                    // This naturally handles negative entryMonthIndex (e.g. entry at -5):
                    // At m=0, monthsSinceEntry = 5. 5 <= 12 -> No Replacements.
                    // At m=7, monthsSinceEntry = 12. 12 <= 12 -> No Replacements.
                    // At m=8, monthsSinceEntry = 13. 13 > 12 -> Replacements Start.

                    if (monthsSinceEntry > 12) {
                        let annualRate = 0;
                        const lifeYear = Math.ceil(monthsSinceEntry / 12); // 13-24 -> Year 2. 25-36 -> Year 3.

                        if (lifeYear === 2) {
                            annualRate = cullingRateY2;
                        } else if (lifeYear >= 3) {
                            annualRate = replacementRateStable;
                        }

                        // Monthly entitlement
                        // RATE APPLIES TO ORIGINAL COUNT
                        const monthlyRate = (annualRate * entryCount) / 12;

                        cohortReplacementAccumulator += monthlyRate;

                        const replaceCount = Math.floor(cohortReplacementAccumulator);

                        if (replaceCount > 0) {
                            cohortReplacementAccumulator -= replaceCount;

                            // Lead Time: Replacement arrives 'giltLeadTime' months BEFORE it is needed productive?
                            // OR we add it now to become productive later.
                            // Standard logic: Add now (m), becomes active at m + leadTime.
                            const productiveMonthIndex = m + giltLeadTime;

                            replacements.push({
                                monthIndex: m,
                                productiveMonthIndex: productiveMonthIndex,
                                giltsAdded: replaceCount,
                                year: Math.floor(m / 12) + 1,
                                quarter: Math.ceil((m % 12 + 1) / 3),
                                monthYear: getMonthYear(m, inputs.projectStartDate),
                                productiveMonthYear: getMonthYear(productiveMonthIndex, inputs.projectStartDate),
                                cullingRate: annualRate,
                                dayNumber: m * 30,
                                cohortId: `GILT-REP-${cohort.id}-M${m}`,
                                targetCohortId: cohort.id,
                                isReplacement: true
                            });
                        }
                    }
                }
            });
        }
    }
    return replacements;
};

// CRITICAL FUNCTION: Track sow cohorts and calculate culling
// This ensures population balance: Gilts IN = Sows OUT
const calculateSowPopulationWithCulling = (inputs, giltArrivals, initialStableHerd = 0) => {
    const totalMonths = inputs.projectDuration * 12;

    const sowCohorts = []; // Track each gilt cohort (including Cohort 0)
    const monthlyPopulation = [];
    let cullAccumulator = 0; // Carry over fractional culling targets

    // === ADD COHORT 0 (EXISTING STABLE HERD) ===
    // Cohort 0 is a stable farm that uses Year 3+ Stable Farm Culling Rate
    if (initialStableHerd > 0) {
        console.log(`🏠 Adding Cohort 0 (Stable Herd) to sowCohorts: ${initialStableHerd} sows`);
        sowCohorts.push({
            arrivalMonth: -1, // Already productive before project start
            count: initialStableHerd,
            cohortId: 'COHORT-0-INITIAL',
            isInitialStock: true,
            isCohort0: true, // Flag to identify Cohort 0
            ageInMonths: 0
        });
    }

    // Initialize cohort tracking from gilt arrivals
    // FILTER OUT old stable cohorts that conflict with Cohort 0
    giltArrivals.forEach(arrival => {
        // SKIP old stable cohorts (GILT-Y*-Stable) - they conflict with Cohort 0
        const isOldStableCohort = arrival.cohortId && String(arrival.cohortId).includes('Stable');
        if (isOldStableCohort) {
            console.log(`⏭️ Skipping old stable cohort: ${arrival.cohortId} (conflicts with Cohort 0)`);
            return; // Skip this cohort
        }

        sowCohorts.push({
            arrivalMonth: Math.floor(arrival.day / 30),
            count: arrival.count,
            cohortId: arrival.cohortId,
            isInitialStock: arrival.cohortId && (
                String(arrival.cohortId).startsWith('AUTO-SS') ||
                String(arrival.cohortId) === 'COHORT-0-INITIAL'
            ),
            ageInMonths: 0
        });
    });

    // Track replacement gilts with lead time (separate from giltArrivals to avoid accumulation)
    const replacementGiltTracking = [];

    // Calculate population for each month
    for (let m = 0; m < totalMonths; m++) {
        const monthYear = getMonthYear(m, inputs.projectStartDate);
        const year = Math.floor(m / 12) + 1;

        // Age all existing cohorts
        sowCohorts.forEach(cohort => {
            if (cohort.arrivalMonth <= m) {
                cohort.ageInMonths = m - cohort.arrivalMonth;
            }
        });

        // === CULLING CALCULATION ===
        // Cohort 0 will be processed in the standard culling loop below
        let annualCullingRate;

        // CHECK ID directly from the cohort object in the loop logic below
        // But here we calculate a BASE rate. We need to apply rate PER COHORT.

        // REFACTOR: Determine rate inside the cohort loop (lines 563+) OR split cohorts.
        // Current logic filters "activeCohorts" and applies a global rate "monthlyCullingRate".
        // This is problematic if we have mixed rates.

        // MODIFIED LOGIC:
        // We calculate "Total Cull Target" by summing target culls from each cohort based on its specific rate.

        // === DETERMINING CULLING TARGETS ===

