const MultiExitSalesSection = ({ exitPoints, setExitPoints, addExitPoint, deleteExitPoint, updateExitPoint, fatteningParams, formatNumber }) => {
    const totalPercentage = exitPoints
        .filter(e => e.active)
        .reduce((sum, e) => sum + parseFloat(e.percentage || 0), 0);

    const isValid = Math.abs(totalPercentage - 100) < 0.01;

    return (
        <div className="bg-white rounded-lg shadow-sm border p-6 space-y-4">
            <div className="flex justify-between items-center">
                <h3 className="text-lg font-bold text-gray-800">📊 Sales Strategy - Multi-Exit Points</h3>
                <button
                    onClick={addExitPoint}
                    className="px-3 py-1.5 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-1 text-sm"
                >
                    <Plus size={14} /> Add Exit Point
                </button>
            </div>

            <div className="p-3 bg-blue-50 rounded-lg border border-blue-200">
                <p className="text-sm text-blue-800">
                    <strong>ℹ️ Info:</strong> Define multiple exit points where you'll sell pigs at
                    different weights. Total percentage must equal 100%.
                </p>
            </div>

            {/* Exit Points List */}
            <div className="space-y-3">
                {exitPoints.map((exit, idx) => {
                    // Calculate metrics for this exit point
                    const startWeight = fatteningParams.weanerPurchaseWeight;
                    const weightGain = exit.targetWeight - startWeight;
                    const daysInFattening = weightGain / fatteningParams.adg;
                    const feedNeeded = weightGain * fatteningParams.fcr;
                    const pigsAtThisExit = Math.round(
                        fatteningParams.monthlyPigletPurchase *
                        (1 - fatteningParams.mortality) *
                        exit.percentage / 100
                    );

                    return (
                        <div
                            key={exit.id}
                            className={`border-2 rounded-lg p-4 ${exit.active ? 'border-orange-300 bg-orange-50' : 'border-gray-200 bg-gray-50'}`}
                        >
                            <div className="flex justify-between items-start mb-3">
                                <h4 className="font-semibold text-gray-800">Exit Point #{idx + 1}</h4>
                                <div className="flex gap-2">
                                    <label className="flex items-center gap-1 text-sm">
                                        <input
                                            type="checkbox"
                                            checked={exit.active}
                                            onChange={(e) => updateExitPoint(exit.id, 'active', e.target.checked)}
                                            className="w-4 h-4"
                                        />
                                        Active
                                    </label>
                                    {exitPoints.filter(e => e.active).length > 1 && (
                                        <button
                                            onClick={() => deleteExitPoint(exit.id)}
                                            className="text-red-600 hover:text-red-700"
                                        >
                                            <Trash2 size={16} />
                                        </button>
                                    )}
                                </div>
                            </div>

                            <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
                                <div>
                                    <label className="block text-xs font-medium text-gray-700 mb-1">
                                        Exit Month
                                    </label>
                                    <input
                                        type="number"
                                        value={exit.exitMonth}
                                        onChange={(e) => updateExitPoint(exit.id, 'exitMonth', parseInt(e.target.value) || 0)}
                                        className="w-full px-2 py-1.5 text-sm border rounded-lg"
                                        min="1"
                                        max="12"
                                    />
                                </div>

                                <div>
                                    <label className="block text-xs font-medium text-gray-700 mb-1">
                                        Target Weight (kg)
                                    </label>
                                    <input
                                        type="number"
                                        value={exit.targetWeight}
                                        onChange={(e) => updateExitPoint(exit.id, 'targetWeight', parseFloat(e.target.value) || 0)}
                                        className="w-full px-2 py-1.5 text-sm border rounded-lg"
                                        min="10"
                                        max="200"
                                    />
                                </div>

                                <div>
                                    <label className="block text-xs font-medium text-gray-700 mb-1">
                                        % of Pigs Sold
                                    </label>
                                    <input
                                        type="number"
                                        value={exit.percentage}
                                        onChange={(e) => updateExitPoint(exit.id, 'percentage', parseFloat(e.target.value) || 0)}
                                        className="w-full px-2 py-1.5 text-sm border rounded-lg"
                                        min="0"
                                        max="100"
                                        step="1"
                                    />
                                </div>

                                <div>
                                    <label className="block text-xs font-medium text-gray-700 mb-1">
                                        Price per kg (IDR)
                                    </label>
                                    <input
                                        type="number"
                                        value={exit.pricePerKg}
                                        onChange={(e) => updateExitPoint(exit.id, 'pricePerKg', parseFloat(e.target.value) || 0)}
                                        className="w-full px-2 py-1.5 text-sm border rounded-lg"
                                    />
                                </div>
                            </div>

                            {/* Calculated Metrics */}
                            <div className="p-3 bg-white rounded-lg border border-orange-200">
                                <div className="text-xs text-gray-600 space-y-1">
                                    <div className="flex justify-between">
                                        <span>📈 Days in fattening:</span>
                                        <span className="font-semibold">{Math.round(daysInFattening)} days</span>
                                    </div>
                                    <div className="flex justify-between">
                                        <span>📈 Weight gain:</span>
                                        <span className="font-semibold">{weightGain.toFixed(1)} kg</span>
                                    </div>
                                    <div className="flex justify-between">
                                        <span>📈 Feed needed per pig:</span>
                                        <span className="font-semibold">{feedNeeded.toFixed(1)} kg</span>
                                    </div>
                                    <div className="flex justify-between">
                                        <span>📈 Pigs sold at this exit:</span>
                                        <span className="font-semibold text-orange-600">{formatNumber(pigsAtThisExit)} head</span>
                                    </div>
                                    <div className="flex justify-between">
                                        <span>💰 Revenue per pig:</span>
                                        <span className="font-semibold text-green-600">
                                            {formatNumber(exit.targetWeight * exit.pricePerKg / 1000, 1)}K IDR
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>

            {/* Validation Summary */}
            <div className={`p-4 rounded-lg border-2 ${isValid ? 'bg-green-50 border-green-400' : 'bg-red-50 border-red-400'}`}>
                <h4 className="font-semibold text-sm mb-2">Summary Validation</h4>
                <div className="text-sm space-y-1">
                    <div className="flex justify-between">
                        <span>Total % Allocated:</span>
                        <span className={`font-bold ${isValid ? 'text-green-600' : 'text-red-600'}`}>
                            {totalPercentage.toFixed(1)}% {isValid ? '✓' : '✗ Must be 100%'}
                        </span>
                    </div>
                    <div className="flex justify-between">
                        <span>Total Pigs In:</span>
                        <span className="font-semibold">{formatNumber(fatteningParams.monthlyPigletPurchase)} head</span>
                    </div>
                    <div className="flex justify-between">
                        <span>Mortality Applied ({fatteningParams.mortality * 100}%):</span>
                        <span className="font-semibold">{formatNumber(Math.round(fatteningParams.monthlyPigletPurchase * fatteningParams.mortality))} head</span>
                    </div>
                    <div className="flex justify-between">
                        <span>Actual Pigs Sold:</span>
                        <span className="font-semibold text-green-600">
                            {formatNumber(Math.round(fatteningParams.monthlyPigletPurchase * (1 - fatteningParams.mortality)))} head
                        </span>
                    </div>
                </div>
            </div>
        </div>
    );
};

